[Unit]
Description=VSM Toolbox
After=network.target

[Service]
Type=simple
User=vsm
Group=vsm
WorkingDirectory=/opt/vsm-toolbox
Environment=VSM_HOST=0.0.0.0
Environment=VSM_PORT=8080
Environment=VSM_DATABASE=/var/lib/vsm-toolbox/vsm.sqlite3
EnvironmentFile=-/etc/default/vsm-toolbox
ExecStart=/usr/bin/python3 /opt/vsm-toolbox/updater.py
Restart=always
RestartSec=5s
StateDirectory=vsm-toolbox
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
